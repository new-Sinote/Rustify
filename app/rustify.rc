#include <windows.h>

IDI_ICON1 ICON "assets/rustify.ico"
1 24 "rustify.exe.manifest"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Rustify contributors"
      VALUE "FileDescription", "Rustify"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "rustify"
      VALUE "LegalCopyright", "MIT licensed"
      VALUE "OriginalFilename", "rustify.exe"
      VALUE "ProductName", "Rustify"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
